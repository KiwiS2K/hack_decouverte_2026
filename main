from places import find_places

resp = input('Enter keywords to search for (e.g. "ramen", "anime store", "museum"): ').strip()
while not resp:
    resp = input('Please enter at least one keyword: ').strip()
city = input('City or area (leave blank for none): ').strip() or None

for p in find_places(resp, city):
    print(f"{p['name']} ({p['rating']}) - {p['address']}\n  {p['maps_url']}")
